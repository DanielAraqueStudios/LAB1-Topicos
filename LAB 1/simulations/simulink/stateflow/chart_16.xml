        <P Name="isEML">1</P>
        <P Name="script">function [dtheta, ddxf, ddxr]=fcn(xf, xr, theta, dxf, dxr, f, p)

g = 9.81;        % m/s^2
mf = 30;         % kg
mr = 50;         % kg
kf  = 10000;     % N/m
kr  = 15000;     % N/m
ksf = 19500;     % N/m
ksr = 12500;     % N/m
bsf = 1000;      % Ns/m
bsr = 1100;      % Ns/m
a = 0.8;         % m
b = 0.7;         % m
c = 0.5;         % m

dtheta = (- f*c - ksf*xf*a - ksf*a^2*theta + ksr*xr*b - ksr*b^2*theta + bsr*dxr*b + bsf*dxf*a)/(bsr*b^2 + bsf*a^2)
ddxf = (- mf*g - kf*xf + kf*p - ksf*xf - ksf*a*theta - bsf*dxf - bsf*a*dtheta)/mf
ddxr = (- mr*g - kr*xr - ksr*xr + ksr*b*theta - bsr*dxr + bsr*b*dtheta)/mr

 ;
</P>
      </eml>
